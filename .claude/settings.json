{
  "permissions": {
    "allow": ["Bash(core/lease.sh release:*)"],
    "deny": [
      "Edit(/core/**)",
      "Edit(/mods/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/config.example.yaml)",
      "Edit(/README.md)",
      "Edit(/CHANGELOG.md)",
      "Edit(/VERSION)",
      "Edit(/docs/**)",
      "Edit(/config.yaml)",
      "Edit(/state/**)",
      "Edit(/vault/evidence/**)"
    ]
  },
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/core/session-start.py", "timeout": 30}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/core/lease-board.py", "timeout": 5}]}],
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/core/guard-bash.py", "timeout": 5}]},
      {"matcher": "Edit|Write|NotebookEdit", "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/core/boundary-hook.py", "timeout": 5}]},
      {"matcher": "Bash|Edit|Write|NotebookEdit", "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/core/pitfall-inject.py", "timeout": 5}]}
    ],
    "PostToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/core/boundary-hook.py", "timeout": 10}]},
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/core/ami-hook.py outcome", "timeout": 5}]}
    ],
    "PostToolUseFailure": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/core/ami-hook.py outcome", "timeout": 5}]}],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/core/boundary-hook.py", "timeout": 10}]},
      {"hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/core/verify-hook.py", "timeout": 60}]},
      {"hooks": [{"type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/core/capture-tick.sh", "timeout": 10}]}
    ],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/core/capture-tick.sh --final", "timeout": 5}]}],
    "PreCompact": [
      {"hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/core/pitfall-inject.py", "timeout": 5}]}
    ]
  }
}
