# Pulled checkouts — carry other repos' histories. Committing these would
# put harness code and KB content into the product repo (PRD §5).
target/
vault/

# Per-deployment config. The contract lives in config.example.yaml.
config.yaml

# A deployment's local deny rules (e.g. protecting the operator's live
# harness, read as audit ground truth) name absolute paths on that specific
# machine. Committing this file would leak that operator's layout and fail
# the identity-leakage test (core/tests/test_identity.bats).
.claude/settings.local.json

# The deployment's own brief text (Claude Code loads it after CLAUDE.md). A
# release never touches it, so local lines never conflict with an update;
# boundary.edit_brief in config.yaml decides whether Daedalus may write it.
CLAUDE.local.md

# Written by Claude Code when the lease-board mod loads with --plugin-dir.
mods/lease-board/tsconfig.json

.DS_Store

# Runtime state written by the SessionEnd capture hook (e.g. transcript byte
# offsets). Per-deployment, not product content — committing it would leak
# one operator's runtime state into a public repo.
state/

# The capture hook's log target. Same reasoning as state/ above.
.capture.log

# Bytecode from importing core modules (recall-inject.py imports capture.py).
# Compiled files embed the building machine's absolute paths, which the
# identity-leakage guard correctly rejects for a public repo.
__pycache__/
*.pyc

# SDD scratch — per-plan subagent workspace, never product content.
.superpowers/

# Linked worktrees for feature branches (superpowers:using-git-worktrees).
.worktrees/

# Lease worktrees (spec §4.2): one checkout of the target per window, cut from
# target/<repo>. Untracked noise in every boundary-hook status otherwise.
worktrees/
