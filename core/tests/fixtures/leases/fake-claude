#!/usr/bin/env bash
# Records how it was launched; never runs anything.
# The record is composed first and appended in one write: a reader polling for a non-empty log
# (spawn is detached) must never see the ARGV line without the environment lines under load.
rec="$(printf 'ARGV: %s\n' "$*"; env | grep -E '^(DAEDALUS_LEASE|CLAUDE_CODE_SESSION_KIND)=')"
printf '%s\n' "$rec" >> "${FAKE_CLAUDE_LOG:?}"
exit 0
