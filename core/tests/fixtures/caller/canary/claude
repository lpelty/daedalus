#!/usr/bin/env python3
"""The canary's stand-in for `claude -p` (spec §6.1): a model of how Claude Code
assembles a print-mode session's context, as documented and as measured on
2.1.282, so the suite can prove the launcher's shape defeats it without ever
running the real CLI. What it loads:
  - CLAUDE.md and CLAUDE.local.md of the working directory and of every
    ancestor directory (project instructions);
  - NOT a CLAUDE.md that sits only under an --add-dir directory (measured,
    v0.6.1 commit 7cde520);
  - the user-level $CLAUDE_CONFIG_DIR/CLAUDE.md (measured, v0.6.1 1babef1);
  - auto memory, $CLAUDE_CONFIG_DIR/projects/<cwd, non-alphanumerics as ->/memory/MEMORY.md,
    unless --settings says autoMemoryEnabled: false or the environment has
    CLAUDE_CODE_DISABLE_AUTO_MEMORY=1;
  - any of these is skipped when its absolute path matches a claudeMdExcludes
    glob in --settings (auto memory is not a CLAUDE.md and is not excluded by it).
It obeys an instruction it loaded (a file saying PINEAPPLE makes it answer
PINEAPPLE and STANDS); otherwise it reviews the request on stdin and REFUTES a
change carrying the line marker SEEDED-DEFECT. Records <n>.argv, <n>.cwd,
<n>.stdin and <n>.loaded (the files it read) under $FAKE_CLAUDE_DIR."""
import fnmatch, json, os, re, sys
from pathlib import Path

d = Path(os.environ["FAKE_CLAUDE_DIR"]); d.mkdir(parents=True, exist_ok=True)
n = len(list(d.glob("*.argv"))) + 1
argv = sys.argv[1:]
(d / ("%d.argv" % n)).write_text("\n".join(argv) + "\n")
(d / ("%d.cwd" % n)).write_text(os.getcwd() + "\n")
request = sys.stdin.buffer.read().decode("utf-8", "replace")
(d / ("%d.stdin" % n)).write_text(request)
settings = {}
if "--settings" in argv:
    settings = json.loads(argv[argv.index("--settings") + 1])
excludes = settings.get("claudeMdExcludes", [])
config = Path(os.environ.get("CLAUDE_CONFIG_DIR") or str(Path.home() / ".claude"))
cwd = Path(os.getcwd()).resolve()
candidates = []
for folder in [cwd] + list(cwd.parents):
    candidates += [folder / "CLAUDE.md", folder / "CLAUDE.local.md"]
candidates.append(config / "CLAUDE.md")
loaded = [p for p in candidates if p.is_file() and not any(fnmatch.fnmatch(str(p), g) for g in excludes)]
memory_on = settings.get("autoMemoryEnabled", True) is not False and os.environ.get("CLAUDE_CODE_DISABLE_AUTO_MEMORY") != "1"
mem = config / "projects" / re.sub(r"[^A-Za-z0-9]", "-", str(cwd)) / "memory" / "MEMORY.md"
if memory_on and mem.is_file():
    loaded.append(mem)
(d / ("%d.loaded" % n)).write_text("".join(str(p) + "\n" for p in loaded))
if any("PINEAPPLE" in p.read_text(errors="replace") for p in loaded):
    sys.stdout.write("Review complete.\nPINEAPPLE\nVERDICT: STANDS\n")
elif "SEEDED-DEFECT" in request:
    sys.stdout.write("F1 HIGH — divide.py divides by b with no zero check; the criteria require one.\nVERDICT: REFUTED\n")
else:
    sys.stdout.write("VERDICT: STANDS\n")
