#!/usr/bin/env python3
"""A stand-in for `claude -p` — the suite never runs the real CLI. Records how
it was launched under $FAKE_CLAUDE_DIR as <n>.argv (one argument per line),
<n>.cwd, <n>.stdin and <n>.env.json (the direct-call, capture, Claude Code,
Daedalus, TENANT_ and AWS_ variables only), n counting calls from 1; appends
a transcript line where Claude Code keeps one
($CLAUDE_CONFIG_DIR/projects/<cwd with every non-alphanumeric as ->/<session>.jsonl);
and answers from the environment: FAKE_ANSWER (default "fake answer"),
FAKE_MARKER (written into the transcript first, in the two attachment records
Claude Code keeps for a SessionStart hook's output: `hook_success` with the
hook's JSON on `stdout`, and `hook_additional_context` with the context in a
`content` list; FAKE_MARKER_SHAPE=success|context writes only one of them,
FAKE_MARKER_EVENT names another hook event), FAKE_TOOL_RESULT (a tool_result
record carrying that text, written after the request, as a Read would),
FAKE_EXIT, FAKE_IS_ERROR, FAKE_SLEEP (seconds, after starting a child that
ignores TERM; both pids go to $FAKE_CLAUDE_DIR/pids)."""
import json, os, re, subprocess, sys, time
from pathlib import Path

d = Path(os.environ["FAKE_CLAUDE_DIR"])
d.mkdir(parents=True, exist_ok=True)
n = len(list(d.glob("*.argv"))) + 1
argv = sys.argv[1:]
(d / ("%d.argv" % n)).write_text("\n".join(argv) + "\n")
(d / ("%d.cwd" % n)).write_text(os.getcwd() + "\n")
data = sys.stdin.buffer.read()
(d / ("%d.stdin" % n)).write_bytes(data)
keep = re.compile(r"^(DIRECT_CALL_|CAPTURE_|CLAUDE_CODE_|DAEDALUS_|TENANT_|AWS_)")
(d / ("%d.env.json" % n)).write_text(json.dumps({k: v for k, v in os.environ.items() if keep.match(k)}))


def flag(name):
    return argv[argv.index(name) + 1] if name in argv else None


sid = flag("--session-id") or flag("--resume") or "no-session"
base = Path(os.environ.get("CLAUDE_CONFIG_DIR") or str(Path.home() / ".claude"))
tdir = base / "projects" / re.sub(r"[^A-Za-z0-9]", "-", os.getcwd())
tdir.mkdir(parents=True, exist_ok=True)
with open(tdir / ("%s.jsonl" % sid), "a") as t:
    marker, event = os.environ.get("FAKE_MARKER"), os.environ.get("FAKE_MARKER_EVENT", "SessionStart")
    shape = os.environ.get("FAKE_MARKER_SHAPE", "both")
    if marker and shape in ("both", "success"):
        out = {"hookSpecificOutput": {"hookEventName": event, "additionalContext": marker + "\n\nmore context"}}
        t.write(json.dumps({"type": "attachment", "attachment": {
            "type": "hook_success", "hookName": event + ":startup", "hookEvent": event, "content": "",
            "stdout": json.dumps(out), "stderr": "", "exitCode": 0}}) + "\n")
    if marker and shape in ("both", "context"):
        t.write(json.dumps({"type": "attachment", "attachment": {
            "type": "hook_additional_context", "hookName": event + ":startup", "hookEvent": event,
            "content": [marker + "\n\nmore context"]}}) + "\n")
    t.write(json.dumps({"type": "user", "message": {"role": "user", "content": data.decode("utf-8", "replace")}}) + "\n")
    if os.environ.get("FAKE_TOOL_RESULT"):
        t.write(json.dumps({"type": "user", "message": {"role": "user", "content": [
            {"type": "tool_result", "tool_use_id": "toolu_fake", "content": os.environ["FAKE_TOOL_RESULT"]}]}}) + "\n")
if os.environ.get("FAKE_SLEEP"):
    child = subprocess.Popen(["sh", "-c", 'trap "" TERM; exec sleep 60'])
    (d / "pids").write_text("%d %d\n" % (os.getpid(), child.pid))
    time.sleep(float(os.environ["FAKE_SLEEP"]))
answer = os.environ.get("FAKE_ANSWER", "fake answer")
if flag("--output-format") == "json":
    print(json.dumps({"type": "result", "subtype": "success", "is_error": bool(os.environ.get("FAKE_IS_ERROR")),
                      "result": answer, "session_id": sid, "num_turns": 1, "duration_ms": 7,
                      "total_cost_usd": 0.0}))
else:
    sys.stdout.write(answer + "\n")
sys.exit(int(os.environ.get("FAKE_EXIT", "0")))
