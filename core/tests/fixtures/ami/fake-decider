#!/usr/bin/env python3
"""A stand-in for `strands-decider serve` (core/tests, never a model).

Usage: fake-decider serve <model> --port N --device D   (the real CLI's shape, so the supervisor's
launch line needs no fixture branch).

/health answers like server.py: model = basename(checkpoint), checkpoint verbatim, device, max_length 4096.
/v1/systemone answers {"answers": {"<id>": {"type": "noul", "noul": P}}, "usage": {"input_tokens": N}}
for every question in the request, plus "latency_ms".

Environment:
  FAKE_P            P for every question (default 0.5)
  FAKE_P_MAP        "destructive=0.4,suite=0.7" — P keyed on a word found in the question text
  FAKE_DELAY_MS     sleep this long before each /v1/systemone answer
  FAKE_LOG          one JSON line per request: {path, method, question, t0, t1, state (POST only)}
  FAKE_STATUS       answer /v1/systemone with this HTTP status and an error body (e.g. 500)
  FAKE_BAD_ANSWER   =1: answer /v1/systemone with a body that carries no float ("bad answer")
  FAKE_EXIT_WEIGHTS =1: print 'LocalEntryNotFoundError: not found in cache' and exit 1 before binding
  FAKE_ENV_DUMP     write os.environ as JSON to this path at start

--port 0 binds a free port. The first stdout line is the port. Exits on SIGTERM. The server is
threaded, as the real one is (its endpoints run in a threadpool), so two requests at once overlap in
the log unless the client serialises them — which is what the ask lock's test checks.
"""
import json
import os
import signal
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

LOG_LOCK = threading.Lock()


def log(entry):
    path = os.environ.get("FAKE_LOG")
    if not path:
        return
    with LOG_LOCK:
        with open(path, "a") as fh:
            fh.write(json.dumps(entry) + "\n")


def p_for(question):
    m = os.environ.get("FAKE_P_MAP")
    if m:
        for part in m.split(","):
            if "=" not in part:
                continue
            word, val = part.split("=", 1)
            if word.strip() and word.strip().lower() in (question or "").lower():
                return float(val)
    return float(os.environ.get("FAKE_P", "0.5"))


def make_handler(checkpoint, device):
    class H(BaseHTTPRequestHandler):
        def log_message(self, *a):          # quiet
            pass

        def _send(self, code, body):
            data = json.dumps(body).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            t0 = time.time()
            if self.path == "/health":
                body = {"status": "ok", "model": os.path.basename(checkpoint.rstrip("/")) or checkpoint,
                        "checkpoint": checkpoint, "base_model": "fake-base", "num_slots": 24,
                        "max_length": 4096, "temperature": 1.0, "device": device, "prefix_cache": True,
                        "vision": False}
                self._send(200, body)
            else:
                self._send(404, {"detail": "Not Found"})
            log({"path": self.path, "method": "GET", "question": None, "t0": t0, "t1": time.time()})

        def do_POST(self):
            t0 = time.time()
            n = int(self.headers.get("Content-Length") or 0)
            raw = self.rfile.read(n) if n else b""
            try:
                req = json.loads(raw.decode() or "{}")
            except ValueError:
                req = {}
            questions = req.get("questions") or {}
            qtext = None
            for q in questions.values():
                qtext = (q or {}).get("instructions")
                break
            delay = float(os.environ.get("FAKE_DELAY_MS", "0") or 0)
            if self.path != "/v1/systemone":
                self._send(404, {"detail": "Not Found"})
            else:
                if delay:
                    time.sleep(delay / 1000.0)
                status = os.environ.get("FAKE_STATUS")
                if status:
                    self._send(int(status), {"detail": "fake failure"})
                elif os.environ.get("FAKE_BAD_ANSWER") == "1":
                    self._send(200, {"model": "fake", "answers": {k: {"type": "noul"} for k in questions},
                                     "usage": {"input_tokens": 1, "output_tokens": 0}})
                else:
                    state = req.get("state") or ""
                    answers = {k: {"type": "noul", "noul": p_for((v or {}).get("instructions"))}
                               for k, v in questions.items()}
                    self._send(200, {"model": os.path.basename(checkpoint), "answers": answers,
                                     "usage": {"input_tokens": max(1, len(state) // 4), "output_tokens": len(answers)},
                                     "latency_ms": round((time.time() - t0) * 1000, 2)})
            log({"path": self.path, "method": "POST", "question": qtext, "t0": t0, "t1": time.time(),
                 "state": req.get("state")})
    return H


def main(argv):
    if len(argv) < 2 or argv[0] != "serve":
        print("usage: fake-decider serve <model> --port N --device D", file=sys.stderr)
        return 2
    model = argv[1]
    port, device = 0, "cpu"
    i = 2
    while i < len(argv):
        if argv[i] == "--port" and i + 1 < len(argv):
            port = int(argv[i + 1]); i += 2
        elif argv[i] == "--device" and i + 1 < len(argv):
            device = argv[i + 1]; i += 2
        else:
            i += 1
    dump = os.environ.get("FAKE_ENV_DUMP")
    if dump:
        with open(dump, "w") as fh:
            json.dump(dict(os.environ), fh)
    if os.environ.get("FAKE_EXIT_WEIGHTS") == "1":
        print("huggingface_hub.errors.LocalEntryNotFoundError: not found in cache", file=sys.stderr)
        sys.stderr.flush()
        return 1
    srv = ThreadingHTTPServer(("127.0.0.1", port), make_handler(model, device))
    srv.daemon_threads = True
    print(srv.server_address[1], flush=True)
    print("fake-decider: serving %s on port %d (device %s)" % (model, srv.server_address[1], device),
          file=sys.stderr, flush=True)

    def stop(*_):
        threading.Thread(target=srv.shutdown, daemon=True).start()
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        srv.serve_forever(poll_interval=0.1)
    finally:
        srv.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
